{
    "name": "chesslines",
    "version": "0.0.1",
    "author": "mao-sz",
    "description": "Chess opening move trainer",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mao-sz/chesslines.git"
    },
    "type": "module",
    "scripts": {
        "build": "npm run build -w packages/zodSchemas -w client",
        "dev:client": "npm run dev --w client",
        "dev": "npm run build --w packages/zodSchemas && npm run dev --workspaces",
        "lint": "eslint . && prettier --check ."
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "lint-staged": {
        "*.{ts,tsx}": [
            "prettier --check",
            "eslint"
        ],
        "!(*.{ts,tsx})": "prettier --check --ignore-unknown"
    },
    "dependencies": {
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "eslint": "^9.19.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.18",
        "globals": "^15.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.2",
        "prettier": "^3.5.1",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.22.0"
    }
}
